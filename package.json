{
  "name": "ocm991",
  "version": "0.1.1",
  "description": "Плагин долговременной памяти для opencode: факты и предпочтения прошлых сессий попадают в контекст новых.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "memory",
    "agents",
    "long-term-memory"
  ],
  "author": "Oleg (easydev991)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easydev991/opencode-memory-991.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    "./server": "./src/plugin.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check . && tsc --noEmit && bun test",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@opencode/plugin": "^2.2.6",
    "@types/bun": "^1.4.4",
    "typescript": "^5"
  }
}
